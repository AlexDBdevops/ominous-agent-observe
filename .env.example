# Copia este fichero a .env para cambiar valores por defecto.

# Puerto publicado en el host (dentro del container siempre es 4982).
OBSERVE_PORT=4982

# Interfaz del host donde se publica. Por defecto solo localhost.
# Pon 0.0.0.0 únicamente si quieres exponerlo a la red, sabiendo que los
# eventos incluyen comandos, rutas y salidas de tus sesiones.
OBSERVE_BIND=127.0.0.1

# Si lo expones en la red, añade aquí el nombre o IP con el que lo abrirás.
# Cualquier otro Host se rechaza (protección contra DNS rebinding).
# OBSERVE_ALLOWED_HOSTS=mi-equipo.local,192.168.1.20

# Máximo de eventos en memoria (los más antiguos se descartan de la vista).
OBSERVE_MAX_EVENTS=50000

# Solo fuera de Docker (npm start):
# OBSERVE_HOST=127.0.0.1
# OBSERVE_DATA_DIR=./data

# Carpeta de transcripts de Claude Code que se monta en solo lectura para
# calcular los tokens por herramienta. Por defecto ~/.claude/projects.
# CLAUDE_PROJECTS_DIR=C:/Users/tu-usuario/.claude/projects

# Dónde lee el servidor esos transcripts. En Docker ya vale /claude-projects;
# fuera de Docker, sin definir, se usa la ruta que trae cada evento.
# OBSERVE_TRANSCRIPTS_DIR=/claude-projects

# Pon 0 para no leer transcripts (la columna de tokens queda vacía).
# OBSERVE_TOKENS=1
